                  <title level="j">Wiener Zeitschrift für die Kunde des Morgenlandes</title>
                  <imprint>
                     <biblScope unit="volume">114</biblScope>
                     <biblScope unit="page">73-103</biblScope>
                     <date>2024</date>
                     <note type="url">https://phaidra.univie.ac.at/o:2114353</note>
                  </imprint>
               </monogr>
               <note type="tags">
                  <note type="tag">out:TUNOCENT</note>
                  <note type="tag">
                     <name type="reg">Maghreb</name>
                     <geo>27.750000 9.300000</geo>
                  </note>
                  <note type="tag">
                     <name type="reg">Tunisia</name>
                     <geo>34.000000 9.000000</geo>
                  </note>
                  <note type="tag">vt:grammar</note>
                  <note type="tag">vt:transcribed texts</note>
               </note>
               <note type="abstract">In this contribution seven texts from a 72-year-old female speaker from the village Magsam Trab in the Kasserine Governorate of Central Tunisia are transcribed and translated. Based on these texts, important phonological, morphological, syntactic and lexical features of this dialect are described and provided with examples. As hitherto no texts have been published from this region, this contribution aims to broaden our knowledge of Central Tunisian Bedouin-type dialects.</note>
            </biblStruct>
