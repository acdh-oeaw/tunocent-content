               <analytic>
                  <title level="a">The Arabic dialect spoken in Southeastern Kasserine (Central Tunisia): Texts and Linguistic pecularities</title>
                  <author>
                     <forename>Veronika</forename>
                     <surname>Ritt-Benmimoun</surname>
                  </author>
               </analytic>
