                  <figure>
                     <graphic type="fullscale" decls="#profile_El_Guettar_01_graphic038" url="Guettar-shrine-desc3.jpg"/>
                     <graphic url="Guettar-shrine-desc3.jpg" decls="#profile_El_Guettar_01_graphic038" type="thumbnail"/>
                     <head>Table bearing an inscription</head>
                  </figure>
                  <figure>
                     <graphic type="fullscale" decls="#profile_El_Guettar_01_graphic039" url="Guettar-golden-plaque.jpg"/>
                     <graphic url="Guettar-golden-plaque.jpg" decls="#profile_El_Guettar_01_graphic039" type="thumbnail"/>
                     <head>Golden plaque next to the shrine</head>
                  </figure>
                  <figure>
                     <graphic type="fullscale" decls="#profile_El_Guettar_01_graphic040" url="Guettar-flags.jpg"/>
                     <graphic url="Guettar-flags.jpg" decls="#profile_El_Guettar_01_graphic040" type="thumbnail"/>
